# PostgreSQL database and application user, used by both the database and backend containers.
DB_NAME=test_database
DB_USER=database_user
# Replace with your database password. Use separate credentials for local and production.
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Secret used to sign authentication tokens. Replace with a securely generated random value.
# Use a different secret in each environment and keep it out of version control.
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET

# Shared by Caddy and the backend. Use your public HTTPS origin in production.
# No trailing slash or path, for example https://app.example.com.
APP_BASE_URL=http://localhost

# Local Mailpit accepts a test sender. Production requires a Resend-verified sending domain.
EMAIL_FROM="Reading Groups <no-reply@example.test>"

# Local email capture. All values are explicit, including unused credentials.
SMTP_HOST=mailpit
SMTP_PORT=1025
# Mailpit does not require authentication; keep both variables present but empty locally.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
SMTP_STARTTLS_REQUIRED=false

# On the production VPS, replace the SMTP values above with:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=<your Resend API key>
# SMTP_AUTH=true
# SMTP_STARTTLS_ENABLE=true
# SMTP_STARTTLS_REQUIRED=true
# The API key is supplied as SMTP_PASSWORD; a separate RESEND_API_KEY variable is not needed.

# Used only by compose.prod.yaml. Local source builds ignore these variables.
# Set these to your published images on the VPS.
WEB_IMAGE=ghcr.io/your-account/reading-groups-web:latest
API_IMAGE=ghcr.io/your-account/reading-groups-api:latest
